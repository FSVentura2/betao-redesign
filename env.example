# ==========================================
# BETÃO ENTERPRISE - CONFIGURAÇÃO DE AMBIENTE
# ==========================================
# NUNCA comite valores reais em repositórios Git!

NODE_ENV=production
PORT=3000
APP_URL=https://betao.bet.br

# Banco de Dados Seguro (TLS OBRIGATÓRIO)
DATABASE_URL=postgresql://betao_user:STRONG_ENCRYPTED_PASSWORD@db.betao.internal:5432/betao_prod?sslmode=require

# Chaves de Criptografia e Autenticação
JWT_SECRET=super_secret_high_entropy_key_minimum_64_bytes_long_random_hex
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=another_super_secret_high_entropy_key_for_refresh_token
REFRESH_TOKEN_EXPIRES_IN=7d

# Rate Limiting & Proteção contra Ataques
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Provedores de API & IA (Google Stitch / OCR)
# Isoladas estritamente no backend!
STITCH_API_KEY=YOUR_SECURE_STITCH_API_KEY_HERE
ANTI_BOT_SECRET_KEY=YOUR_CLOUDFLARE_TURNSTILE_OR_RECAPTCHA_SECRET
